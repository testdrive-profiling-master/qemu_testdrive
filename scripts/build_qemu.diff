diff --git a/Makefile b/Makefile
index 54547a37b1..f22d28a162 100644
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,8 @@
 # Makefile for QEMU.
+CURDIR=$(shell pwd)/build
+PYTHON=/ucrt64/bin/python3
+MESON=meson
+NINJA=ninja
 
 ifneq ($(words $(subst :, ,$(CURDIR))), 1)
   $(error main directory cannot contain spaces nor colons)
diff --git a/hw/misc/Kconfig b/hw/misc/Kconfig
index 1543ee6653..d9785271a1 100644
--- a/hw/misc/Kconfig
+++ b/hw/misc/Kconfig
@@ -1,3 +1,8 @@
+config TESTDRIVE
+    bool
+    default y if TEST_DEVICES
+    depends on PCI && MSI_NONBROKEN
+
 config APPLESMC
     bool
     depends on ISA_BUS
diff --git a/hw/misc/meson.build b/hw/misc/meson.build
index 23265f6035..678004494b 100644
--- a/hw/misc/meson.build
+++ b/hw/misc/meson.build
@@ -1,3 +1,4 @@
+system_ss.add(when: 'CONFIG_TESTDRIVE', if_true: files(run_command('ls', 'testdrive/*.c', 'testdrive/*.cpp', check: true).stdout().strip().split('\n')))
 system_ss.add(when: 'CONFIG_APPLESMC', if_true: files('applesmc.c'))
 system_ss.add(when: 'CONFIG_EDU', if_true: files('edu.c'))
 system_ss.add(when: 'CONFIG_FW_CFG_DMA', if_true: files('vmcoreinfo.c'))
diff --git a/meson.build b/meson.build
index 40e3f4ec44..dcd4d35239 100644
--- a/meson.build
+++ b/meson.build
@@ -355,9 +355,9 @@ endforeach
 
 qemu_common_flags = [
   '-D_GNU_SOURCE', '-D_FILE_OFFSET_BITS=64', '-D_LARGEFILE_SOURCE',
-  '-fno-strict-aliasing', '-fno-common', '-fwrapv' ]
+  '-fno-strict-aliasing', '-fno-common', '-fwrapv', '-I' + meson.current_source_dir() + '/include/testdrive', '-I' + meson.current_source_dir() + '/include/testdrive_common', '-I' + meson.current_source_dir() + '/testdrive_framework' ]
 qemu_cflags = []
-qemu_ldflags = []
+qemu_ldflags = ['-lstdc++', '-llua']
 
 if host_os == 'darwin'
   # Disable attempts to use ObjectiveC features in os/object.h since they
@@ -729,10 +729,8 @@ warn_flags = [
   '-Wold-style-declaration',
   '-Wold-style-definition',
   '-Wredundant-decls',
-  '-Wshadow=local',
   '-Wstrict-prototypes',
   '-Wtype-limits',
-  '-Wundef',
   '-Wvla',
   '-Wwrite-strings',
 
@@ -745,6 +743,8 @@ warn_flags = [
   '-Wno-string-plus-int',
   '-Wno-tautological-type-limit-compare',
   '-Wno-typedef-redefinition',
+  '-Wno-unused-variable',
+  '-Wno-unused-function',
 ]
 
 if host_os != 'darwin'
